{
  "Version": "5.0",
  "Statement": [
    {
      "Effect": "Deny",
      "Action": [
        "sts:agencies:assumeWithOIDC"
      ],
      "Resource": [
        "*"
      ],
      "Condition": {
        "StringEquals": {
          "g:FederatedProvider": [
            "<PUBLIC_FEDERATED_PROVIDER_A>",
            "<PUBLIC_FEDERATED_PROVIDER_B>",
            "<PUBLIC_FEDERATED_PROVIDER_C>"
          ]
        }
      }
    }
  ],
  "_hc_note": "IAM 5.0 身份策略示例：Version 固定为 5.0，Action 采用「服务名:资源类型:操作」三段式，Resource 采用数组格式，条件键与运算符按官方授权参考校准；联邦身份提供方取值改为占位符，由使用者按实际环境填写；_hc_note 为仓库说明字段，附加到 IAM 前请删除，所有占位符需替换为实际值。"
}
