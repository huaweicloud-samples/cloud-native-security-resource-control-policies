{
  "Version": "5.0",
  "Statement": [
    {
      "Sid": "EnforceOnlyServicePrincipalsAndRolesCanSetSessionTags",
      "Effect": "Deny",
      "Action": [
        "sts::tagSession"
      ],
      "Resource": [
        "*"
      ],
      "Condition": {
        "StringEquals": {
          "g:TagKeys": [
            "cce-cluster-urn",
            "cce-cluster-name",
            "kubernetes-namespace",
            "kubernetes-service-account",
            "kubernetes-pod-name",
            "kubernetes-pod-uid"
          ]
        },
        "BoolIfExists": {
          "g:PrincipalIsService": "false"
        },
        "Null": {
          "g:PrincipalTag/cce-cluster-urn": "true",
          "g:PrincipalTag/cce-cluster-name": "true",
          "g:PrincipalTag/kubernetes-namespace": "true",
          "g:PrincipalTag/kubernetes-service-account": "true",
          "g:PrincipalTag/kubernetes-pod-name": "true",
          "g:PrincipalTag/kubernetes-pod-uid": "true"
        }
      }
    }
  ],
  "_hc_note": "IAM 5.0 身份策略示例：Version 固定为 5.0，Action 采用「服务名:资源类型:操作」三段式，Resource 采用数组格式，条件键与运算符按官方授权参考校准；_hc_note 为仓库说明字段，附加到 IAM 前请删除，所有占位符需替换为实际值。"
}
