{
  "Version": "5.0",
  "Statement": [
    {
      "Sid": "DenyUntrustedIssuer",
      "Effect": "Deny",
      "Action": [
        "sts:agencies:assumeWithOIDC"
      ],
      "Resource": [
        "*"
      ],
      "Condition": {
        "StringNotEqualsIfExists": {
          "oidc:iss": [
            "<TRUSTED_ISSUER_URL_A>",
            "<TRUSTED_ISSUER_URL_B>"
          ]
        },
        "Null": {
          "oidc:iss": "false"
        }
      }
    },
    {
      "Sid": "DenyUntrustedAudience",
      "Effect": "Deny",
      "Action": [
        "sts:agencies:assumeWithOIDC"
      ],
      "Resource": [
        "*"
      ],
      "Condition": {
        "StringNotEqualsIfExists": {
          "oidc:aud": [
            "https://<API_ENDPOINT_A>",
            "https://<API_ENDPOINT_B>"
          ]
        },
        "Null": {
          "oidc:aud": "false"
        }
      }
    },
    {
      "Sid": "DenyLongSession",
      "Effect": "Deny",
      "Action": [
        "sts:agencies:assumeWithOIDC"
      ],
      "Resource": [
        "*"
      ],
      "Condition": {
        "NumberGreaterThan": {
          "sts:DurationTime": "300"
        }
      }
    }
  ],
  "_hc_note": "IAM 5.0 身份策略示例：Version 固定为 5.0，Action 采用「服务名:资源类型:操作」三段式，Resource 采用数组格式，条件键与运算符按官方授权参考校准；联邦令牌条件改用 oidc:iss / oidc:aud / sts:DurationTime；会话时长约束由 NumberGreaterThan 表达；_hc_note 为仓库说明字段，附加到 IAM 前请删除，所有占位符需替换为实际值。"
}
