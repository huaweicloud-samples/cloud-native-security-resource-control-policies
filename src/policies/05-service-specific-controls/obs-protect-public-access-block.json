{
  "Version": "5.0",
  "Statement": [
    {
      "Sid": "DenyRemovingPublicAccessBlock",
      "Effect": "Deny",
      "Action": [
        "obs:bucket:deleteBucketPublicAccessBlock"
      ],
      "Resource": [
        "obs:*:*:bucket:*"
      ]
    },
    {
      "Sid": "DenyPublicBucketAcl",
      "Effect": "Deny",
      "Action": [
        "obs:bucket:putBucketAcl"
      ],
      "Resource": [
        "obs:*:*:bucket:*"
      ],
      "Condition": {
        "StringMatch": {
          "obs:x-obs-acl": [
            "public-read",
            "public-read-write",
            "public-read-delivered",
            "public-read-write-delivered"
          ]
        }
      }
    }
  ],
  "_hc_note": "IAM 5.0 身份策略示例：Version 固定为 5.0，Action 采用「服务名:资源类型:操作」三段式，Resource 采用数组格式，条件键与运算符按官方授权参考校准；账号级公共访问阻断在 OBS 由控制台全局设置承载，策略侧改为桶级阻断；补齐可执行的 Deny 语句：禁止移除公共访问阻断 + 禁止设置公开 ACL；_hc_note 为仓库说明字段，附加到 IAM 前请删除，所有占位符需替换为实际值。"
}
